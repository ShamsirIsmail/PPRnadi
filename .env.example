# ==============================================================================
# PPR NADI Environment Configuration
# ==============================================================================
# Copy this file to .env.local and populate with your Supabase credentials.
# Never commit real credentials or service role keys to source control.

# Supabase Public API (Accessible by client & browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Server-Only Service Role Key (NEVER expose to browser / client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Single-Estate Synthetic Demo Identification
NEXT_PUBLIC_ESTATE_ID=ppr-sentosa-demo
NEXT_PUBLIC_ESTATE_NAME="PPR Sentosa (SYNTHETIC DEMO)"

# ==============================================================================
# AI Drafting & Speech Transcription (Server-Only Credentials)
# ==============================================================================
# Provide either Google Gemini API Key or OpenAI API Key for server-side
# speech-to-text audio processing and intelligent incident draft structuring.
# These keys are NEVER exposed to the browser or client-side bundles.
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

